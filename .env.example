# Server Configuration
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/shopsphere

# Client Origin
CLIENT_URL=http://localhost:5173

# xAI Grok Imagine Video Integration
XAI_API_KEY=your_xai_api_key_placeholder
XAI_VIDEO_MODEL=grok-imagine-video-1.5
XAI_VIDEO_BASE_URL=https://api.x.ai/v1
XAI_DEFAULT_RESOLUTION=720p
XAI_DEFAULT_ASPECT_RATIO=9:16
XAI_MAX_DURATION=10

# Authentication Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_key_placeholder
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_placeholder

# Media Cloud Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Payment Gateway
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
