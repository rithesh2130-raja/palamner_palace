# Server Configuration
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/shopsphere

# Client Origin
CLIENT_URL=http://localhost:5173

# Authentication Secrets (Architecture Placeholders)
JWT_ACCESS_SECRET=your_jwt_access_secret_key_placeholder
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_placeholder

# Media Cloud Storage (Architecture Placeholders)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Payment Gateway (Architecture Placeholders)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
